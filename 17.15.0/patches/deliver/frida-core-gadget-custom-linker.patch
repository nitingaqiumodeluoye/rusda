+	/* 自定义链接器加载本模块时（例如把 .so 直接 mmap 进内存、不注册进系统 soinfo
+	 * 链表的加载器），Gum.Process.enumerate_modules() 看不到我们，our_range 会是
+	 * null，从而触发上面 detect_location 的断言。这里退回直接读 /proc/self/maps ——
+	 * 它不依赖 soinfo，也不依赖任何 linker 内部状态。
+	 *
+	 * 不用 Gum.Process.enumerate_ranges()：它回调里给出的 Gum.FileMapping 是含
+	 * owned 字符串的结构体，取值会触发结构体拷贝，而 gum 并没有提供对应的
+	 * copy/destroy 辅助函数（C 层会报 undeclared function gum_file_mapping_copy）。
+	 * 自己读 maps 则完全绕开这个结构体。
+	 *
+	 * 顺带把 our_path 也找出来 —— 它是 Gadget 定位自身 .config 文件的关键：自定义
+	 * 加载器写下的容器路径会出现在 maps 里，据此推导出的 <stem>.config.so 与预置的
+	 * 暂存配置路径正好吻合。
+	 *
+	 * 解析方式与 frida-core 自己的 src/linux/proc-maps.vala 保持一致（同一套正则），
+	 * 以免对 maps 格式的假设与上游分叉。
+	 *
+	 * 注意：Vala 不允许在闭包里捕获 ref/out 参数，所以这里用 while 循环而非回调。 */
+	private void detect_location_from_maps (Gum.Address our_address, ref string? our_path, ref Gum.MemoryRange? our_range) {
+		string contents;
+		try {
+			FileUtils.get_contents ("/proc/self/maps", out contents);
+		} catch (FileError e) {
+			return;
+		}
+
+		uint64 address = (uint64) our_address;
+
+		MatchInfo info;
+		if (!/^([0-9a-f]+)-([0-9a-f]+) (\S{4}) ([0-9a-f]+) ([0-9a-f]{2,}:[0-9a-f]{2,}) (\d+) *([^\n]*)$/m.match (contents, 0, out info))
+			return;
+
+		while (true) {
+			uint64 start = uint64.parse (info.fetch (1), 16);
+			uint64 end = uint64.parse (info.fetch (2), 16);
+
+			if (address >= start && address < end) {
+				uint64 inode = uint64.parse (info.fetch (6));
+				var path = info.fetch (7);
+				if (inode != 0 && path.length != 0)
+					our_path = path;
+
+				var range = Gum.MemoryRange ();
+				range.base_address = (Gum.Address) start;
+				range.size = (size_t) (end - start);
+				our_range = range;
+				return;
+			}
+
+			bool more;
+			try {
+				more = info.next ();
+			} catch (RegexError e) {
+				return;
+			}
+			if (!more)
+				return;
+		}
+	}
