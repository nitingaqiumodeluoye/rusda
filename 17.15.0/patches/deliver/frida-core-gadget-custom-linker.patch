+	 * 暂存配置路径正好吻合。 */
+	private void detect_location_from_ranges (Gum.Address our_address, ref string? our_path, ref Gum.MemoryRange? our_range) {
+		Gum.Process.enumerate_ranges (Gum.PageProtection.READ, (details) => {
+			var range = details.range;
+			if (our_address < range.base_address || our_address >= range.base_address + range.size)
